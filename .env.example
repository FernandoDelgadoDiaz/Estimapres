# API Keys for Claude (Anthropic)
# Development: used by frontend in browser (Vite)
VITE_CLAUDE_API_KEY=sk-ant-...

# Production: used by Netlify function (server-side)
CLAUDE_API_KEY=sk-ant-...

# Legacy key name (optional)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Supabase (Auth + Database) — REQUERIDO para el backend real de las
# capacidades configurables (reglas, historial, correcciones, aprendizajes).
# Sin estas variables la app cae automáticamente a localStorage (modo degradado,
# solo este dispositivo). Se leen en el browser (prefijo VITE_).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key